<!-- DataTales Example -->
<div
  class="tab-pane fade show active"
  id="show-hotnews"
  role="tabpanel"
  aria-labelledby="home-tab"
>
  <div class="card shadow mb-4 mt-2">
    <div class="card-body">
      <div class="table-responsive">
        <table
          class="table table-bordered"
          id="dataTable"
          width="100%"
          cellspacing="0"
        >
          <thead>
            <tr>
              <th>No</th>
              <th>Title</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% for(let i = 0; i<hotNewss.length; i++) { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= hotNewss[i].News.title %></td>
                <td>
                  <form action="/admin/hotnews/<%= hotNewss[i].id %>/delete?_method=DELETE" method="POST">
                    <button type="submit" class="btn btn-danger btn-circle btn-sm" title="Hapus Item"><i class="fas fa-trash"></i></button>
                  </form>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

