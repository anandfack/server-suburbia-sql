<!-- DataTales Example -->
<div
  class="tab-pane fade show active"
  id="show-merchandise"
  role="tabpanel"
  aria-labelledby="home-tab"
>
  <div class="card shadow mb-4 mt-2">
    <div class="card-body">
      <div class="table-responsive">
        <table
          class="table table-bordered"
          id="dataTable"
          width="100%"
          cellspacing="0"
        >
          <thead>
            <tr>
              <th>No</th>
              <th>Title</th>
              <th>Size</th>
              <th>Price</th>
              <th>Shopee</th>
              <th>Tokopedia</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% for(let i = 0; i<merchandise.length; i++) { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= merchandise[i].title %></td>
                <td><%= merchandise[i].size %></td>
                <td>$ <%= merchandise[i].price %></td>
                <td>
                  <a href="<%= merchandise[i].shopeeUrl %>" type="button" class="btn btn-info btn-circle btn-sm" target=”_blank”>
                    <i class="fa fa-eye"></i>
                  </a>
                </td>  
                <td>
                  <a href="<%= merchandise[i].tokopediaUrl %>" type="button" class="btn btn-info btn-circle btn-sm" target=”_blank”>
                    <i class="fa fa-eye"></i>
                  </a>
                </td>  
                <td>
                  <form action="/admin/merchandise/<%= merchandise[i].id %>/delete?_method=DELETE" method="POST">
                    <a href="/admin/merchandise/show-image/<%= merchandise[i].id %>" type="button" class="btn btn-info btn-circle btn-sm"><i class="fas fa-image"></i></a>
                    <a href="/admin/merchandise/<%= merchandise[i].id %>" class="btn btn-warning btn-circle btn-sm"><i class="fas fa-edit"></i></a>
                    <button type="submit" class="btn btn-danger btn-circle btn-sm"><i class="fas fa-trash"></i></button>
                  </form>
                    </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div
  class="tab-pane fade"
  id="profile"
  role="tabpanel"
  aria-labelledby="profile-tab"
>
  ...
</div>
