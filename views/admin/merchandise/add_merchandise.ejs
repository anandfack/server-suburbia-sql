<div
  class="tab-pane fade"
  id="add-merchandise"
  role="tabpanel"
  aria-labelledby="profile-tab"
>
  <div class="row">
    <!-- Merchandise Form -->
    <div class="col-md-6">
      <form
        action="/admin/merchandise"
        method="POST"
        enctype="multipart/form-data"
      >
        <div class="card shadow mb-4 mt-2">
          <div class="card-body">
            <h4 class="card-title text-center">Merchandise</h4>
            <div class="form-group">
              <label for="name">Title</label>
              <input
                type="text"
                class="form-control"
                placeholder="Enter title"
                name="title"
                required
              />
            </div>
            <div class="row">
              <div class="form-group col-md-6">
                <label for="name">Price</label>
                <input
                  type="number"
                  class="form-control"
                  placeholder="Enter price"
                  name="price"
                  required
                />
              </div>
              <div class="form-group col-md-6">
                <label for="name">Size</label>
                <input
                  type="text"
                  class="form-control"
                  placeholder="Enter size"
                  name="size"
                  required
                />
              </div>
            </div>
            <div class="row">
              <div class="form-group col-md-6">
                <label for="name">Shopee</label>
                <input
                  type="text"
                  class="form-control"
                  placeholder="Enter shopee"
                  name="shopeeUrl"
                  required
                />
              </div>
              <div class="form-group col-md-6">
                <label for="name">Tokopedia</label>
                <input
                  type="text"
                  class="form-control"
                  placeholder="Enter tokopeida"
                  name="tokopediaUrl"
                  required
                />
              </div>
              <div class="form-group">
                <label for="name">Description</label>
                <textarea name="about" class="form-control"></textarea>
              </div>
            </div>
            <button type="submit" class="btn btn-primary btn-block">
              Save
            </button>
          </div>
        </div>
      </form>
    </div>
    <!-- Image Merchandise form -->
    <div class="col-md-6">
      <form
        action="/admin/image-merchandise"
        method="POST"
        enctype="multipart/form-data"
      >
        <div class="card shadow mb-4 mt-2">
          <div class="card-body">
            <h4 class="card-title text-center">Image Merchandise</h4>
            <div class="form-group">
              <label for="name">Merchandise</label>
              <select id="select-state" name="merchandiseId">
                <option value="">--- select optional aritst ---</option>
                <% for(let i = 0; i < selectMerchandise.length; i++){ %>
                <option value="<%= selectMerchandise[i].id %>">
                  <%= i + 1 %>. <%= selectMerchandise[i].title %>
                </option>
                <% } %>
              </select>
            </div>

            <div class="form-check form-switch mb-2">
              <input
                class="form-check-input"
                type="checkbox"
                id="flexSwitchCheckDefault"
                name="isDefault"
                value="true"
              />
              <label class="form-check-label" for="flexSwitchCheckDefault"
                >Set as thumbnail</label
              >
            </div>

            <div class="form-group">
              <label for="name">Image</label>
              <input type="file" class="form-control" name="image" required />
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>
