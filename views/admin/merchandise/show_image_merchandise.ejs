<!-- DataTales Example -->
<div
  class="tab-pane fade show active"
  id="show-image-merchandise"
  role="tabpanel"
  aria-labelledby="home-tab"
>
  <div class="row">
    <% for (let i = 0; i < merchandise.imageMerchandises.length; i++) { %>
    <div class="col md-4">
      <div class="card shadow mb-4 mt-2">
        <div class="card-body">
          <img
            src="http://127.0.0.1:4000/<%= merchandise.imageMerchandises[i].imageUrl %>"
            alt="image"
            style="width: 100%; display: block"
          />
          <% if (merchandise.imageMerchandises[i].isDefault === true) { %>
          <span class="badge badge-pill badge-success mt-4" style="float: right"
            >Selected Pictures</span
          >
          <% } else { %>
          <span class="badge badge-pill badge-info mt-4" style="float: right"
            >Others picture</span
          >
          <% } %>
        </div>
      </div>
    </div>
    <% } %>
  </div>
  <a href="/admin/merchandise" class="btn btn-warning">back</a>
</div>
