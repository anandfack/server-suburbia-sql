<div
  class="tab-pane fade show active"
  id="add-item"
  role="tabpanel"
  aria-labelledby="profile-tab"
>
  <form action="/admin/gallery/<%= gallery.id %>?_method=PUT" method="POST" enctype="multipart/form-data">
    <div class="card shadow mb-4 mt-2">
      <div class="card-body">
        <div class="row">
          <div class="form-group col-md-6">
            <label for="name">Type</label>
            <input
              type="text"
              class="form-control"
              placeholder="Enter type"
              name="type"
              value="<%= gallery.type %>"
              required
            />
          </div>
          <div class="form-group col-md-6">
            <label for="name">Artist</label>
            <select id="select-state" name="categoryId">
              <option value="<%= gallery.Artist.id%>"> <%= gallery.Artist.firstName%> <%= gallery.Artist.lastName%> </option>
              <% for(let i = 0; i < artist.length; i++){ %>
                <option value="<%= artist[i].id %>"><%= i + 1 %>. <%= artist[i].firstName %> <%= artist[i].lastName %></option>
              <% } %>
            </select>
          </div>
        </div>
        <div class="form-group col-md-4">
            <label for="name">Image</label>
            <input type="file" class="form-control" name="image" multiple>
        </div>
        <button type="submit" class="btn btn-primary">Save</button>
  </form>
</div>
