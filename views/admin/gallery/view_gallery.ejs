<%- include('../../partials/header.ejs') %>

<body id="page-top">
  <!-- Page Wrapper -->
  <div id="wrapper">
    <!-- sidebar -->
    <%- include('../../partials/sidebar.ejs') %>

    <!-- Content Wrapper -->
    <div id="content-wrapper" class="d-flex flex-column">
      <!-- Main Content -->
      <div id="content">
        <!-- topbar -->
        <%- include('../../partials/navbar.ejs') %>

        <!-- Begin Page Content -->
        <div class="container-fluid">
          <!-- Page Heading -->
          <%- include('../../partials/message.ejs') %>

          <h1 class="h3 mb-4 text-gray-800">Gallery</h1>
          <!-- end page heading -->

          <% if(action == 'view'){ %>
          <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
              <button
                class="nav-link active"
                id="home-tab"
                data-toggle="tab"
                href="#show-item"
                type="button"
                role="tab"
                aria-controls="home"
                aria-selected="true"
              >
                Show Gallery
              </button>
            </li>
            <li class="nav-item" role="presentation">
              <button
                class="nav-link"
                id="profile"
                data-toggle="tab"
                href="#add-item"
                type="button"
                role="tab"
                aria-controls="profile"
                aria-selected="false"
              >
                Add Gallery
              </button>
            </li>
          </ul>
          <div class="tab-content" id="myTabContent">
            <%- include('show_table_gallery.ejs') %> <%-
            include('add_gallery.ejs') %>
          </div>
          <%} else if(action == "show image") {%>
          <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
              <button
                class="nav-link active"
                id="home-tab"
                data-toggle="tab"
                href="#show-image"
                type="button"
                role="tab"
                aria-controls="home"
                aria-selected="true"
              >
                Show Image
              </button>
            </li>
          </ul>
          <div class="tab-content" id="myTabContent">
            <%- include('show_image_gallery.ejs') %>
          </div>
          <%} else { %>
          <ul class="nav nav-tabs" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
              <button
                class="nav-link active"
                id="home-tab"
                data-toggle="tab"
                href="#edit-item"
                type="button"
                role="tab"
                aria-controls="home"
                aria-selected="true"
              >
                Edit Gallery
              </button>
            </li>
          </ul>
          <div class="tab-content" id="myTabContent">
            <%- include('edit_gallery.ejs') %>
          </div>

          <%}%>
          <!-- End of Table -->
        </div>
        <!-- /.container-fluid -->
      </div>
      <!-- End of Main Content -->

      <!-- footer -->
      <%- include('../../partials/footer.ejs') %>
    </div>
    <!-- End of Content Wrapper -->
  </div>
  <!-- End of Page Wrapper -->

  <!-- Scroll to Top Button-->
  <a class="scroll-to-top rounded" href="#page-top">
    <i class="fas fa-angle-up"></i>
  </a>

  <!-- script -->
</body>
<%- include('../../partials/script.ejs') %>

<script>
  new TomSelect("#select-state", {
    create: false,
    sortField: {
      field: "text",
      direction: "asc",
    },
  });
  new TomSelect("#select-state-type", {
    create: false,
    sortField: {
      field: "text",
      direction: "asc",
    },
  });
</script>
