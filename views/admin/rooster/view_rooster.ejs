  <!-- END OF SCRIPT -->
  <script>
    $("#dataTable").on("click", ".button-update", function () {
      let id = $(this).data("id")
      let nameBand = $(this).data("nameband")
      let city = $(this).data("city")
      let genre = $(this).data("genre")
      let instagram = $(this).data("instagram")
      let spotify = $(this).data("spotify")
      let description = $(this).data("description")
      $("#edit-modal").modal("show")
      $(".id").val(id)
      $(".city").val(city)
      $(".genre").val(genre)
      $(".instagram").val(instagram)
      $(".spotify").val(spotify)
      $(".description").val(description)
      $(".nameBand").val(nameBand)
      CKEDITOR.replace("about_rooster")
    })
    CKEDITOR.replace("about")
    new TomSelect("#select-state",{
        create: false,
        sortField: {
            field: "text",
            direction: "asc"
        }
    });
  </script>
  
</html>
