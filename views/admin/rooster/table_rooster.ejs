<!-- DataTales Example -->
<div class="card shadow mb-4">
  <div class="card-header py-3">
    <!-- Button trigger modal -->
    <button
      type="button"
      class="btn btn-primary"
      data-toggle="modal"
      data-target="#add-modal"
    >
      <i class="fas fa-plus"></i>
    </button>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table
        class="table table-bordered"
        id="dataTable"
        width="100%"
        cellspacing="0"
      >
        <thead>
          <tr>
            <th>No</th>
            <th>Name Band</th>
            <th>City</th>
            <th>Genre</th>
            <th>Country</th>
            <th>Instagram url</th>
            <th>spotify url</th>
            <th>Image</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% for(let i = 0; i<rooster.length; i++) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= rooster[i].nameBand %></td>
              <td><%= rooster[i].city %></td>
              <td><%= rooster[i].genre %></td>
              <td><%= rooster[i].country %></td>
              <td>
                <a href="<%= rooster[i].instagram %>" type="button" class="btn btn-info btn-circle btn-sm" target=”_blank”>
                  <i class="fa fa-eye"></i>
                </a>
              </td>
              <td>
                <a href="<%= rooster[i].spotify %>" type="button" class="btn btn-info btn-circle btn-sm" target=”_blank”>
                <i class="fa fa-eye"></i>
                </a>
              </td>
              <td>
                <img src="http://localhost:4000/<%= rooster[i].imageUrl %>" alt="<%= rooster[i].imageUrl %>" width="70px">
              </td>
              <td>
                <form action="/admin/rooster/<%= rooster[i].id %>?_method=DELETE" method="POST">
                  <a href="javascript:void()" type="button" class="btn btn-warning btn-circle btn-sm button-update" data-id="<%= rooster[i].id %>" data-nameband="<%= rooster[i].nameBand %>" data-city="<%= rooster[i].city %>"data-genre="<%= rooster[i].genre %>"data-country="<%= rooster[i].country %>"data-instagram="<%= rooster[i].instagram %>"data-description="<%= rooster[i].description %>"data-spotify="<%= rooster[i].spotify %>"><i class="fas fa-edit"></i></a>
                  <button type="submit" class="btn btn-danger btn-circle btn-sm"><i class="fas fa-trash"></i></button>
                </form>
                  </td>
            </tr>
          <% } %>
        </tbody>

      </table>
    </div>
  </div>
</div>
