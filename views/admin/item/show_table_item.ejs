<!-- DataTales Example -->
<div
  class="tab-pane fade show active"
  id="show-item"
  role="tabpanel"
  aria-labelledby="home-tab"
>
  <div class="card shadow mb-4 mt-2">
    <div class="card-body">
      <div class="table-responsive">
        <table
          class="table table-bordered"
          id="dataTable"
          width="100%"
          cellspacing="0"
        >
          <thead>
            <tr>
              <th>No</th>
              <th>Title</th>
              <th>Artist</th>
              <th>Category</th>
              <th>Location</th>
              <th>City</th>
              <th>Country</th>
              <th>Date and Time</th>
              <th>Organizer</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% for(let i = 0; i<item.length; i++) { %>
              <tr>
                <td><%= i + 1 %></td>
                <td><%= item[i].title %></td>
                <td><%= item[i].artist %></td>
                <td><%= item[i].Category.name %></td>
                <td><%= item[i].location %></td>
                <td><%= item[i].city %></td>
                <td><%= item[i].country %></td>
                <td><%= item[i].date %>, <%= item[i].startHour %> - <%= item[i].endHour %></td>
                <td><%= item[i].organizer %></td>
                <td>
                  <form action="/admin/item/<%= item[i].id %>/delete?_method=DELETE" method="POST">
                    <a href="/admin/item/show-image/<%= item[i].id %>" type="button" class="btn btn-info btn-circle btn-sm" title="Detail Gambar"><i class="fas fa-image"></i></a>
                    <a href="/admin/item/<%= item[i].id %>" class="btn btn-warning btn-circle btn-sm" title="Edit Item"><i class="fas fa-edit"></i></a>
                    <a href="<%= item[i].ticket %>" type="button" title="Lihat Tiket" class="btn btn-info btn-circle btn-sm <%= item[i].ticket === '-' ? 'disabled' : '' %>" target="_blank">
                      <i class="fa fa-eye"></i>
                    </a>
                    <button type="submit" class="btn btn-danger btn-circle btn-sm" title="Hapus Item"><i class="fas fa-trash"></i></button>
                  </form>
                    </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div
  class="tab-pane fade"
  id="profile"
  role="tabpanel"
  aria-labelledby="profile-tab"
>
  ...
</div>
